# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (NEXUS INSIGHT)
# Copia este archivo como '.env' en la raíz y rellena con tus valores reales
# ==============================================================================

# ──────────────────────────────────────────────
# ENTORNO (development / production)
# ──────────────────────────────────────────────
NEXUS_ENV=development

# ──────────────────────────────────────────────
# DESARROLLO — Variables para docker compose up
# ──────────────────────────────────────────────

# Seguridad & API
JWT_SECRET=dev_secret_key_extremely_long_and_secure_for_local_testing_2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
ADMIN_USERNAME=admin

# Personalización (aparece en navbar web)
COMPANY_NAME=Your Company

# Puertos expuestos en localhost
API_PORT=8000
DB_PORT=5432
OLLAMA_PORT=11434     # Si ya tienes Ollama en el host, cámbialo (ej: 11435).
                      # Docker avisará si el puerto está ocupado.

# Base de Datos (PostgreSQL)
DB_USER=nexus_db_user
DB_PASSWORD=local_secure_dev_password_2026
DB_NAME=nexus_insight_db

# Enlaces de infraestructura
OLLAMA_HOST=http://ollama_service:11434
MODEL_NAME=qwen2.5:1.5b

# Conexión directa (scripts/CLI fuera de Docker)
DATABASE_URL=postgresql+asyncpg://nexus_db_user:local_secure_dev_password_2026@localhost:5432/nexus_insight_db

# ──────────────────────────────────────────────
# PRODUCCIÓN — Variables para nexus.py prod
# (docker-compose.prod.yml sobreescribe ENV=production)
# ──────────────────────────────────────────────

PROD_DB_USER=nexus_db_user
PROD_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32chars+
PROD_DB_NAME=nexus_insight_db
PROD_JWT_SECRET=CHANGE_ME_PROD_JWT_SECRET_64chars_minimum
PROD_MODEL_NAME=qwen2.5:1.5b
PROD_JWT_ALGORITHM=HS256
PROD_API_PORT=8000

# Personalización (aparece en navbar web en producción)
PROD_COMPANY_NAME=Your Company

# Dominio público para HTTPS (Caddy). Usa la IP pública del VPS: 143.198.10.10.sslip.io
# Si lo dejas vacío, Caddy servirá en http://localhost:80 sin TLS.
SERVER_NAME=

# La contraseña de admin en producción se lee de ./secrets/admin_password.txt
# (ver docker-compose.prod.yml → secrets → admin_password)

# ──────────────────────────────────────────────
# BACKUP — Variables para scripts/backup_db.sh
# ──────────────────────────────────────────────
# DB_PASSWORD=<password>   # Requerida (sin default)
# DB_HOST=localhost        # Opcional (default)
# DB_PORT=5432             # Opcional (default)
# DB_USER=nexus_db_user    # Opcional (default)
# DB_NAME=nexus_insight_db # Opcional (default)
# BACKUP_DIR=./backups     # Opcional (default)
# KEEP_DAYS=7              # Opcional (default)